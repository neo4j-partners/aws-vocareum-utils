# One course's Vocareum coordinates. Copy this file to <name>.env in this
# directory, fill it in, and select it with --course <name> on any tool:
#
#     cp courses/course.env.example courses/graphrag.env
#     uv run vocareum-diagnose --no-start --course graphrag
#
# Or set VOCAREUM_COURSE=graphrag in .env and drop the flag.
#
# This file is layered OVER the repository root .env, so put here only what
# differs between courses and leave the rest in .env. Real environment
# variables still beat both. Every *.env in this directory is git-ignored.
#
# What belongs here:  the Vocareum ids, the lab account and stack, and anything
#                     else whose value is a property of this course's part.
# What belongs in .env: the API token, the region, and the organization
#                     identifiers, because they are the same for every course.

# ---------------------------------------------------------------------------
# Which Vocareum part this course is
# ---------------------------------------------------------------------------

# Course, assignment, and part IDs from the info icon in the Vocareum UI. Open
# the assignment, click the info icon, and copy the IDs.
VOCAREUM_COURSE_ID=12345
VOCAREUM_ASSIGNMENT_ID=67890
VOCAREUM_PART_ID=1

# Vocareum user ID of the enrolled student whose session the tools act on.
# Enrolment is per course, so this cannot be shared with another course.
VOCAREUM_USER_ID=24680

# Login of that student. Recorded because Vocareum publishes no endpoint that
# returns the caller's own user ID.
VOCAREUM_USER_EMAIL=you+student1@example.com

# ---------------------------------------------------------------------------
# The account this course's sessions land in
#
# These expire. Vocareum rotates a pool of accounts and ending a session moves
# the allocation, so LAB_AWS_ACCOUNT_ID and LAB_STACK_NAME are both good only
# for the session that is open right now.
# ---------------------------------------------------------------------------

# The student AWS account the live session is in. The probe, sweep, and expect
# tools all refuse to report unless the credentials they hold belong to it.
LAB_AWS_ACCOUNT_ID=000000000000

# The CloudFormation stack Vocareum creates per student. Vocareum builds this
# name from course, part, lab, and account, so it is not assembled from the
# values above and has to be recorded whole.
LAB_STACK_NAME=c00000a0000000l00000000t0w000000000000

# The role CloudFormation deploys as, named in an SCP denial message.
LAB_DEPLOYER_ROLE=sys0000000

# ---------------------------------------------------------------------------
# Optional per-course overrides
# ---------------------------------------------------------------------------

# Region this course's lab deploys into. Only set it if the course is not
# us-east-1, which no current course is: AgentCore and the Nova multimodal
# embedding model exist nowhere else.
# AWS_REGION=us-east-1

# Where this course's assets live, when they live in another repository. A
# workshop that owns its own repository owns its Vocareum definition too, so
# this names that repository's `vocareum/` directory. The tooling then reads
# `course.json`, `lab.template`, and `expected.json` from there instead of from
# `courses/<name>/` here.
#
# Read relative to this repository's root, or as an absolute path. Leave it out
# for a course whose assets are committed here, which is what
# `neo4j-fundamentals` does.
#
# A value naming a directory that does not exist is an error. Check out the
# course repository beside this one, or remove the line. The tooling never falls
# back to `courses/<name>/`, because a fall back would upload one course's
# template under another course's name and report success.
#
# This file is git-ignored, so a fresh clone does not know where the course
# lives until someone writes this line. That is the cost of keeping real
# Vocareum identifiers out of git.
# COURSE_ASSET_DIR=../neo4j-hotel-booking-agent-workshop/environment/vocareum
