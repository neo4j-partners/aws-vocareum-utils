# TEMPLATE. Copy to arns.env and fill in the five site-specific values.
#
#   cp bedrock-key/arns.env.example bedrock-key/arns.env
#
# arns.env is gitignored by the *.env rule and holds the real values. This file
# is committed and must never carry a real account number, a real email address,
# or anything resembling a credential. The account number below is 000000000000
# on purpose.
#
# Resource ARNs for the instructor-account Bedrock API key used to route
# workshop model calls when a lab account is not entitled to the models.
#
# Account ${BEDROCK_KEY_ACCOUNT_ID}, region us-east-1. Contains no secret. The key value
# itself never belongs in this repository.
#
# The three model ids below are the complete runtime set for the workshop.
# Verified against the workshop tree on 2026-08-26.

BEDROCK_KEY_ACCOUNT_ID=000000000000
BEDROCK_KEY_REGION=us-east-1
BEDROCK_KEY_USER_NAME=bedrock-api-user
BEDROCK_KEY_USER_ARN=arn:aws:iam::000000000000:user/workshop/bedrock-api-user
BEDROCK_KEY_POLICY_NAME=graphrag-bedrock-key-policy

# Chat model. A cross-region inference profile, so both the account-scoped
# profile ARN and every foundation-model ARN it routes to must be granted.
WORKSHOP_CHAT_MODEL_ID=us.anthropic.claude-sonnet-4-6
WORKSHOP_CHAT_PROFILE_ARN=arn:aws:bedrock:us-east-1:000000000000:inference-profile/us.anthropic.claude-sonnet-4-6
WORKSHOP_CHAT_FM_ARN_USE1=arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-sonnet-4-6
WORKSHOP_CHAT_FM_ARN_USE2=arn:aws:bedrock:us-east-2::foundation-model/anthropic.claude-sonnet-4-6
WORKSHOP_CHAT_FM_ARN_USW2=arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-sonnet-4-6

# Retrieval embeddings, modules 1 through 5. Plain foundation model, us-east-1 only.
WORKSHOP_EMBED_MODEL_ID=amazon.nova-2-multimodal-embeddings-v1:0
WORKSHOP_EMBED_FM_ARN=arn:aws:bedrock:us-east-1::foundation-model/amazon.nova-2-multimodal-embeddings-v1:0

# Agent-memory embeddings, module 6 only. Plain foundation model.
WORKSHOP_MEMORY_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
WORKSHOP_MEMORY_EMBED_FM_ARN=arn:aws:bedrock:us-east-1::foundation-model/amazon.titan-embed-text-v2:0

# The live long-term key. The credential id is an identifier, not a secret, and
# every control below is pinned to it. The 128-character bearer value it names
# is a secret and lives nowhere in this repository.
#
# Both values are empty in this template. Fill them from the output of the
# create call in KEY-LIFECYCLE.md. The credential id is an identifier, not a
# secret. The 128-character key value it names is a secret and belongs in a
# password manager, never in any file here.
BEDROCK_KEY_CREDENTIAL_ID=
BEDROCK_KEY_CREDENTIAL_EXPIRES=

# Where the circuit breaker, the budget, and the invocation-log group send mail.
BEDROCK_KEY_ALERT_EMAIL=you@example.com

# The controls stack. deploy-controls.sh creates it under this name.
BEDROCK_KEY_CONTROLS_STACK=graphrag-bedrock-controls
BEDROCK_KEY_INVOCATION_LOG_GROUP=/aws/bedrock/graphrag-workshop-invocations
BEDROCK_KEY_ADMIN_PROFILE=AdministratorAccess-000000000000

# Circuit-breaker thresholds for estimated Bedrock spend. admin.py passes all
# four into controls.template, so tuning the breaker is an edit here and a
# redeploy. Never edit the template.
#
# The burst threshold trips on a single minute above it. The sustained
# threshold trips only after BEDROCK_KEY_SUSTAINED_PERIODS consecutive
# five-minute periods each average above it, so 3 is fifteen minutes. Keep the
# sustained figure below the burst figure. deploy-controls.sh refuses to deploy
# if it is not.
#
# The total threshold covers the trailing four hours. It defaults to $850 so a
# runaway can still be stopped before an intended $1,000 maximum after metric,
# alarm, and deactivation delay. It is not an invoice-grade hard cap.
# CONTROLS.md shows how the defaults are derived and what changing them costs.
BEDROCK_KEY_BURST_USD_PER_MINUTE=30
BEDROCK_KEY_SUSTAINED_USD_PER_MINUTE=25
BEDROCK_KEY_SUSTAINED_PERIODS=3
BEDROCK_KEY_TOTAL_USD=850
