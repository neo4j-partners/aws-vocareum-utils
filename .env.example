# Configuration for vocareum-diagnose
#
# Copy this file to .env in the repository root and fill in real values:
#
#     cp .env.example .env
#
# .env is git-ignored. Never commit it. Real environment variables always take
# precedence over values in .env, so the same script runs unchanged in CI.
#
# Where the values come from:
#   - The course, assignment, and part IDs are shown behind the info icon in the
#     Vocareum UI. Open the assignment, click the info icon, and copy the IDs.
#   - The API token is generated in Vocareum account settings. It is displayed
#     exactly once at creation time and cannot be retrieved again, so store it
#     somewhere safe when you generate it.
#   - The user ID is the Vocareum user whose lab session you are diagnosing.

# Which course the tools act on. Names a file at courses/<value>.env, whose
# values are layered over this one. Leave it unset to run against this file
# alone, which is what this repository did before courses existed. --course NAME
# on any tool overrides it. See courses/README.md.
# VOCAREUM_COURSE=graphrag

# Vocareum REST API token. Sent as "Authorization: Token <value>".
# Generated in Vocareum account settings and shown only once.
#
# Keep this here rather than in a course file. It is the same for every course,
# and it is displayed once at creation, so a rotated token should be pasted in
# one place however many courses there are.
VOCAREUM_API_KEY=replace-with-your-vocareum-api-token

# Course ID from the info icon in the Vocareum UI.
VOCAREUM_COURSE_ID=12345

# Assignment ID from the info icon in the Vocareum UI.
VOCAREUM_ASSIGNMENT_ID=67890

# Part ID of the assignment part that launches the lab, from the same info icon.
VOCAREUM_PART_ID=1

# Vocareum user ID of the student session being diagnosed.
VOCAREUM_USER_ID=24680

# Optional. Base URL of the Vocareum REST API.
# Defaults to https://api.vocareum.com/api/v2 when unset.
VOCAREUM_API_BASE=https://api.vocareum.com/api/v2

# Optional. AWS region the lab CloudFormation stack deploys into.
# Defaults to us-east-1 when unset. The --region flag overrides this.
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Environment identifiers, recorded for reference.
#
# Nothing below is read by vocareum-diagnose or vocareum-upload.
# Those consume only the seven variables above. These are kept in .env so the
# IDs live in one git-ignored place instead of being scattered through
# documentation that gets committed. Fill them in from your own lab session.
#
# The documents under docs/ refer to these as ${NAME}. docs/evidence.local.md
# holds the same values in a readable table beside the unmodified CloudFormation
# events they came from, and is git-ignored for the same reason this file's real
# counterpart is.
# ---------------------------------------------------------------------------

# The student AWS account the live session is in, a member account in
# Vocareum's organization. This is the one the account guard compares against,
# so it has to be the account the current lab session hands out, not a
# remembered one. It always equals one of the pool members below.
#
# Vocareum holds a pool of accounts per part and moves the allocation between
# sessions, so this value expires. Ending a session is what moves it: the
# account in use is returned for wiping and another member is allocated.
# Refresh it after every rotation with `vocareum-refresh --dry-run`, then repeat
# without `--dry-run`. The guard proves the credentials match this number, and
# the refresh command obtains the number directly from sts:GetCallerIdentity.
LAB_AWS_ACCOUNT_ID=000000000000

# The members of that pool, one variable each, named for the account and not
# for its turn in the rotation. Nothing reads these at run time. They exist so
# the committed documents can say which account a measurement happened in and
# have that stay true afterwards.
#
# This is the point of the split. A finished row records where a measurement
# happened, which never changes; the allocation changes every time a session
# ends. Naming the members "current" and "prior" meant every rotation silently
# rewrote what every finished row claimed. So docs/ write ${LAB_AWS_ACCOUNT_
# POOL_A}, ${LAB_AWS_ACCOUNT_POOL_B} or ${LAB_AWS_ACCOUNT_POOL_C} in a result,
# and ${LAB_AWS_ACCOUNT_ID} only where they mean "whichever is live now".
#
# A, B and C are arbitrary labels assigned in the order the accounts were first
# seen. The pool was recorded as two members until a third turned up live on
# 2026-08-06, so treat the count as a lower bound: a member becomes visible
# only when a session lands in it. A fourth gets LAB_AWS_ACCOUNT_POOL_D rather
# than a renumbering, because the existing letters are load-bearing in
# committed documents. Measured 2026-07-29 and 2026-08-06; see
# docs/vocareum-api.md, "Ending a session".
LAB_AWS_ACCOUNT_POOL_A=000000000000
LAB_AWS_ACCOUNT_POOL_B=000000000000
LAB_AWS_ACCOUNT_POOL_C=000000000000

# The CloudFormation stack Vocareum creates per student. Vocareum builds this
# name by concatenating course, part, lab, and account, so it is not assembled
# from the variables above and has to be recorded whole. The trailing account
# moves when the pool allocation moves, so this expires with LAB_AWS_ACCOUNT_ID.
LAB_STACK_NAME=c00000a0000000l00000000t0w000000000000

# The role CloudFormation deploys as, named in the SCP denial. Full ARN is
# arn:aws:sts::<LAB_AWS_ACCOUNT_ID>:assumed-role/vocareum/<LAB_DEPLOYER_ROLE>
LAB_DEPLOYER_ROLE=sys0000000

# Vocareum's AWS Organization and the management account the SCP is attached
# in. Vocareum owns both, and the SCP sits above the lab account, so only
# Vocareum can change it.
VOCAREUM_ORG_ID=o-xxxxxxxxxx
VOCAREUM_ORG_MANAGEMENT_ACCOUNT_ID=000000000000

# The Vocareum-side organization number, which is a different identifier from
# the AWS organization above and is what Vocareum support asks for. Needed by
# the org-scoped endpoints, GET /orgs/{orgid}/aws_usage and /orgs/{orgid}/s3_labs.
VOCAREUM_ORG_NUMBER=000

# Login of the enrolled student used for diagnostics. Vocareum publishes no
# endpoint returning the caller's own user ID, so a real enrolled user is the
# only way to get a value for VOCAREUM_USER_ID above.
VOCAREUM_USER_EMAIL=you+student1@example.com

# The SCP that denied ec2:RunInstances. Full ARN is
# arn:aws:organizations::<VOCAREUM_ORG_MANAGEMENT_ACCOUNT_ID>:policy/<VOCAREUM_ORG_ID>/service_control_policy/<VOCAREUM_SCP_POLICY_ID>
VOCAREUM_SCP_POLICY_ID=p-xxxxxxxx

# The ordinary AWS account used as a control, to prove a template has no
# intrinsic defect. Not a Vocareum account.
CONTROL_AWS_ACCOUNT_ID=000000000000
CONTROL_VPC_ID=vpc-00000000000000000
